# SkillzMcGee provider examples.
# Copy the relevant block into your shell or local .env loader.
# Do not commit real API keys, ngrok authtokens, or private endpoints.

# Mode A: deterministic fallback
# No variables required.

# Mode B: local Ollama
# NOVA_PROVIDER=ollama
# NOVA_OLLAMA_MODEL=qwen2.5-coder:7b
# NOVA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Mode C: Nova / OpenAI-compatible endpoint
# NOVA_PROVIDER=nova
# NOVA_OPENAI_BASE_URL=https://your-static-domain.example/v1
# NOVA_OPENAI_MODEL=nova-local
# NOVA_API_KEY=replace-with-your-key
