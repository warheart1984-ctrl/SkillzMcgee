{
  "name": "skillzmcgee",
  "version": "2.0.0",
  "description": "Constitutional cognitive runtime with AS-Ω singularity fold",
  "type": "module",
  "main": "src/singularity/index.js",
  "scripts": {
    "test": "node --test tests/singularity.test.js tests/frs.test.js tests/substrations.test.js tests/runtime.test.js tests/behavior.test.js tests/layers.test.js tests/layer_ticks.test.js tests/contracts.test.js tests/governance.test.js tests/invariant_evaluator.test.js tests/wolf1_scaffolds.test.js tests/safe_mode.test.js tests/governance_gate_export.test.js tests/governance_stance_strip.test.js tests/day11_emergence.test.js tests/cockpit_artifacts.test.js tests/prime_operator.test.js tests/cosmology.test.js tests/tension_mgk1.test.js tests/negotiant-core/invariants.test.js tests/negotiant-core/face-independence.test.js tests/negotiant-core/validations.test.js tests/negotiant-core/governance-face.test.js tests/negotiant-core/scripture-face.test.js tests/negotiant-core/cosmology-face.test.js tests/cockpit/indicators.reproducibility.test.js tests/darz/multizone.test.js tests/nova_studio.test.js",
    "test:core": "node --test tests/negotiant-core/invariants.test.js tests/negotiant-core/face-independence.test.js tests/negotiant-core/validations.test.js tests/negotiant-core/governance-face.test.js tests/negotiant-core/scripture-face.test.js tests/negotiant-core/cosmology-face.test.js tests/cockpit/indicators.reproducibility.test.js",
    "test:darz": "node --test tests/darz/multizone.test.js",
    "objectives": "node scripts/governance_cli.mjs objectives",
    "substrations": "node scripts/governance_cli.mjs substrations",
    "graph": "node scripts/governance_cli.mjs graph",
    "receipts": "node scripts/governance_cli.mjs receipts",
    "safe-mode": "node scripts/governance_cli.mjs safe-mode",
    "stance": "node scripts/governance_cli.mjs stance",
    "escalate": "node scripts/governance_cli.mjs escalate",
    "cockpit": "node scripts/governance_cli.mjs cockpit",
    "emergence": "node scripts/governance_cli.mjs emergence",
    "snapshot": "node scripts/governance_cli.mjs snapshot",
    "operator-log": "node scripts/governance_cli.mjs operator-log",
    "console": "node scripts/cockpit_console.mjs full",
    "identity": "node scripts/governance_cli.mjs identity",
    "prime": "node scripts/cockpit_console.mjs prime-full",
    "tension": "node scripts/tension_repl.mjs",
    "core": "node scripts/negotiant_core.mjs",
    "core-rpg-ui": "node scripts/serve_core_rpg.mjs",
    "test:singularity": "node --test tests/singularity.test.js",
    "test:frs": "node --test tests/frs.test.js",
    "test:py": "python tests/test_skillzmcgee.py",
    "seed:governance-gate": "node scripts/seed_governance_gate.mjs",
    "test:governance-gate": "node scripts/seed_governance_gate.mjs && python -m pytest tests/skillzmcgee/ -v",
    "nova-studio": "node nova-studio/server/studio-api.mjs",
    "nova-studio:react": "npm run dev:react --prefix nova-studio",
    "nova-studio:build": "npm run build --prefix nova-studio",
    "nova-studio:build:react": "npm run build:react --prefix nova-studio",
    "test:nova-studio": "node --test tests/nova_studio.test.js",
    "spec:requirements": "node tools/generators/requirements-catalog.mjs",
    "spec:csr": "node tools/generators/csr-registry.mjs",
    "spec:graph": "node tools/generators/proof-graph-index.mjs",
    "spec:cor": "node tools/generators/csr-registry.mjs && node tools/generators/proof-graph-index.mjs && node tools/generators/cor-generate.mjs --out meta/COR-1.0.json",
    "spec:dra": "node tools/generators/dra-analyze.mjs --out meta/DRA-1.0.json",
    "spec:rebuild": "node tools/generators/darp-regenerate.mjs",
    "crk": "node tools/crk.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "constitutional-runtime",
    "receipts",
    "merkle",
    "governance",
    "crk-1"
