{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity-os.dev/schemas/provenance-ledger/v1.1",
  "title": "ProvenanceLedger",
  "description": "PL-1.1 provenance ledger with four-layer binding (CA-1.1, ADR-003, ADR-004, R043)",
  "version": "1.1",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProvenanceEntry" }
    }
  },
  "$defs": {
    "ProvenanceEntry": {
      "type": "object",
      "required": [
        "entry_id",
        "timestamp",
        "input_artifact_id",
        "output_artifact_id",
        "authority_id",
        "authority_version",
        "spec_id",
        "spec_version",
        "implementation_id",
        "implementation_version",
        "assumptions",
        "verification_method",
        "evidence_type",
        "evidence_ref",
        "receipt_id",
        "provenance_hash",
        "parent_hash",
        "status"
      ],
      "properties": {
        "entry_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "input_artifact_id": { "type": "string" },
        "output_artifact_id": { "type": "string" },
        "authority_id": { "type": "string" },
        "authority_version": { "type": "string" },
        "spec_id": { "type": "string" },
        "spec_version": { "type": "string" },
        "implementation_id": { "type": "string" },
        "implementation_version": { "type": "string" },
        "assumptions": {
          "type": "object",
          "required": ["items", "policy_versions", "evaluation_mode"],
          "properties": {
            "items": {
              "type": "array",
              "items": { "type": "string" }
            },
            "policy_versions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evaluation_mode": {
              "type": "string",
              "enum": ["strict", "permissive", "experimental"]
            },
            "constitution_version": { "type": "string" },
            "frame_set_version": { "type": "string" }
          }
        },
        "verification_method": { "type": "string" },
        "evidence_type": { "type": "string" },
        "evidence_ref": { "type": "string" },
        "receipt_id": { "type": "string" },
        "provenance_hash": { "type": "string" },
        "parent_hash": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "notes": { "type": "string" }
      }
    }
  }
}
