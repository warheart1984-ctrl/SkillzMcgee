{
  "$id": "https://continuity-os.dev/schemas/workflow-canvas/recommendation-set/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recommendation Set (Canvas Layer 3)",
  "type": "object",
  "properties": {
    "setVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/recommendation" }
    }
  },
  "required": ["setVersion", "generatedAt", "recommendations"],
  "$defs": {
    "recommendation": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^REC-" },
        "findingIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "recommendation": { "type": "string" },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "governanceImplications": { "type": "array", "items": { "type": "string" } },
        "implementationConstraints": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "findingIds", "recommendation"]
    }
  }
}
