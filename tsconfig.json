{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-ts",
    "declaration": true
  },
  "include": [
    "src/canonical/**/*.ts",
    "src/governance/**/*.ts",
    "src/cli/**/*.ts",
    "src/semantic-bridge/**/*.ts",
    "src/cor/**/*.ts",
    "src/analysis/**/*.ts",
    "src/cor-suite/**/*.ts",
    "src/maturity/**/*.ts",
    "src/hygiene/**/*.ts"
  ]
}
